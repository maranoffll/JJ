{
  "name": "jj-media-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "JJ Media ERP \u2014 production-grade media production ERP (React + TypeScript + Vite + Supabase)",
  "scripts": {
    "build": "vite build",
    "db:concurrency": "node scripts/concurrency-test.mjs",
    "db:deploy": "node scripts/db.mjs migrate",
    "db:local:docker": "docker run --rm -d --name jj-erp-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16-alpine",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:reset": "node scripts/db.mjs reset",
    "db:test": "node scripts/db.mjs test",
    "db:test:keep": "node scripts/db.mjs test --keep",
    "db:verify": "node scripts/db.mjs verify",
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "secret:scan": "node scripts/secret-scan.mjs",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run secret:scan && npm run verify:db && npm run verify:app",
    "verify:app": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:db": "npm run db:test && npm run db:concurrency && npm run db:verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "pg": "^8.13.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.44.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.3"
  }
}
