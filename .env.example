# ============================================================================
# JJ Media ERP — environment template
# Copy to .env.local (never commit real values; .env* is git-ignored).
# ============================================================================
#
# FRONTEND (Vite) — these values are PUBLIC by design and ship in the browser
# bundle. Only ever put the anon / publishable key here.
VITE_SUPABASE_URL=https://zfrgzunauxozqgdjghso.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
VITE_APP_NAME=JJ Media ERP

# ----------------------------------------------------------------------------
# SERVER-SIDE / TOOLING ONLY — never expose to the browser, never prefix with
# VITE_, never commit. Used by the database task runner (scripts/db.mjs).
# ----------------------------------------------------------------------------
# Local PostgreSQL used by `npm run db:test` / `db:concurrency`:
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres

# Live Supabase connection string (Project settings -> Database -> Connection
# string). Required only for `npm run db:deploy`. Keep it out of git.
# DATABASE_URL=postgresql://postgres:<password>@db.zfrgzunauxozqgdjghso.supabase.co:5432/postgres

# Safety switch: destructive database commands refuse to run against a
# non-local host unless this is explicitly set to 1.
# ALLOW_REMOTE_MIGRATIONS=0
